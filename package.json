{
  "name": "ssr-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "media": "node scripts/build-media.mjs",
    "build": "node scripts/build.mjs",
    "mock-gw": "node scripts/run-with-env.mjs development node mock-gw/server.js",
    "dev": "npm run icons && npm run media && node scripts/dev.mjs",
    "dev:redis": "node scripts/dev-local.mjs",
    "dev:local": "npm run dev:redis",
    "start": "node scripts/run-with-env.mjs production node --enable-source-maps dist/server/index.js",
    "start:staging": "node scripts/run-with-env.mjs staging node --enable-source-maps dist/server/index.js",
    "start:dev": "node scripts/run-with-env.mjs development node --import tsx/esm server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-server.mjs",
    "bench:compare": "node scripts/bench/compare-next.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run typecheck && npm run check:cycles && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run smoke"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
