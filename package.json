{
  "name": "origin-loom",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "autocannon>hyperid": "^4.0.0"
    }
  },
  "scripts": {
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "build": "pnpm --filter showroom build",
    "build:packages": "pnpm --filter @originloom/core --filter @originloom/react run build",
    "check:cycles": "pnpm --filter showroom check:cycles",
    "ci": "pnpm run typecheck && pnpm run check:cycles && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run smoke",
    "create-app": "node packages/origin-tooling/bin/create-app.mjs",
    "dev": "pnpm --filter showroom dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 9",
    "lint:fix": "eslint . --fix",
    "smoke": "pnpm --filter showroom smoke",
    "start": "pnpm --filter showroom start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
