# Staging — production kuralları geçerli; Redis zorunlu.
NODE_ENV=production
APP_ENV=staging
PORT=3005
CACHE_BACKEND=redis
CACHE_REQUIRED=false
REDIS_URL=redis://staging-redis.example.internal:6379
GATEWAY_URL=https://gateway.staging.example.com
SITE_URL=https://www.staging.example.com
RELEASE_ID=staging
CACHE_PURGE_SECRET=replace-with-staging-secret
TRUST_PROXY=true
OTEL_SDK_DISABLED=false
