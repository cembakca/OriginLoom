# Yerel geliştirme — Redis gerekmez; in-memory cache kullanır.
# Host adını 127.0.0.1 ile tutarlı kullanın (localhost karışımı cross-origin gecikmesi yaratır).
NODE_ENV=development
APP_ENV=development
PORT=3005
CACHE_BACKEND=memory
CACHE_MAX_ENTRIES=2000
GATEWAY_URL=http://127.0.0.1:4002
SITE_URL=http://127.0.0.1:3005
VITE_DEV_SERVER_URL=http://127.0.0.1:5174
GTM_CONTAINER_ID=GTM-XXXXXX
CACHE_PURGE_SECRET=dev-purge-secret
RELEASE_ID=development
OTEL_SDK_DISABLED=true
