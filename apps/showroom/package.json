{
  "name": "showroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "origin-generate-icons",
    "media": "origin-build-media",
    "build": "origin-build",
    "mock-gw": "origin-run-with-env development node tests/fixtures/gateway/server.js",
    "dev": "origin-dev",
    "dev:redis": "origin-dev-local",
    "dev:local": "pnpm run dev:redis",
    "compose:up": "origin-compose-up",
    "compose:redis": "origin-compose-up --redis",
    "compose:clean": "origin-docker-clean",
    "compose:clean:volumes": "origin-docker-clean --all --volumes",
    "start": "origin-run-with-env production node --enable-source-maps dist/server/index.js",
    "start:memory": "origin-start-memory",
    "start:staging": "origin-run-with-env staging node --enable-source-maps dist/server/index.js",
    "start:dev": "origin-run-with-env development node --import tsx/esm server/index.ts",
    "start:local": "origin-run-local production",
    "start:local:redis": "origin-run-local production --redis",
    "start:staging:local": "origin-run-local staging",
    "start:staging:local:redis": "origin-run-local staging --redis",
    "typecheck": "tsc --noEmit",
    "check:cycles": "origin-check-cycles",
    "test": "vitest run",
    "smoke": "origin-smoke --gateway tests/fixtures/gateway/server.js --expect-gone /kaldirildi --expect-ok /robots.txt",
    "loadtest": "node load-test/run.mjs",
    "loadtest:memory": "node load-test/run.mjs --profile memory",
    "loadtest:redis": "node load-test/run.mjs --profile redis",
    "loadtest:compare": "node load-test/compare.mjs --latest",
    "stress:compare": "node load-test/compare.mjs --latest --stress",
    "stress": "node load-test/stress.mjs",
    "stress:memory": "node load-test/stress.mjs --profile memory",
    "stress:redis": "node load-test/stress.mjs --profile redis",
    "pentest:readiness": "node scripts/pentest-readiness.mjs",
    "pentest:readiness:loadtest": "node scripts/pentest-readiness-loadtest.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@originloom/core": "workspace:*",
    "@originloom/react": "workspace:*",
    "@originloom/shared": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@originloom/tooling": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autocannon": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
