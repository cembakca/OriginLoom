{
  "name": "showroom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "media": "node scripts/build-media.mjs",
    "build": "node scripts/build.mjs",
    "mock-gw": "node scripts/run-with-env.mjs development node ../../tools/mock-gw/server.js",
    "dev": "pnpm run icons && pnpm run media && node scripts/dev.mjs",
    "dev:redis": "node scripts/dev-local.mjs",
    "dev:local": "pnpm run dev:redis",
    "compose:up": "node scripts/compose-up.mjs",
    "compose:redis": "node scripts/compose-up.mjs --redis",
    "compose:clean": "node scripts/docker-clean.mjs",
    "compose:clean:volumes": "node scripts/docker-clean.mjs --all --volumes",
    "start": "node scripts/run-with-env.mjs production node --enable-source-maps dist/server/index.js",
    "start:memory": "node scripts/start-memory.mjs",
    "start:staging": "node scripts/run-with-env.mjs staging node --enable-source-maps dist/server/index.js",
    "start:dev": "node scripts/run-with-env.mjs development node --import tsx/esm server/index.ts",
    "start:local": "node scripts/run-local.mjs production",
    "start:local:redis": "node scripts/run-local.mjs production --redis",
    "start:staging:local": "node scripts/run-local.mjs staging",
    "start:staging:local:redis": "node scripts/run-local.mjs staging --redis",
    "typecheck": "tsc --noEmit",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke-server.mjs",
    "loadtest": "node load-test/run.mjs",
    "loadtest:memory": "node load-test/run.mjs --profile memory",
    "loadtest:redis": "node load-test/run.mjs --profile redis",
    "loadtest:compare": "node load-test/compare.mjs --latest",
    "stress:compare": "node load-test/compare.mjs --latest --stress",
    "stress": "node load-test/stress.mjs",
    "stress:memory": "node load-test/stress.mjs --profile memory",
    "stress:redis": "node load-test/stress.mjs --profile redis",
    "pentest:readiness": "node scripts/pentest-readiness.mjs",
    "pentest:readiness:loadtest": "node scripts/pentest-readiness-loadtest.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@originloom/core": "workspace:*",
    "@originloom/react": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@svgr/cli": "^8.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
