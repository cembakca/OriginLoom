# Kişisel override'lar — bu dosyayı .env.local olarak kopyalayın (gitignore'da).
# Shell ortam değişkenleri her zaman dosyalardan önceliklidir.
#
# cp .env.local.example .env.local

# Cache topolojisi (opsiyonel override):
# CACHE_BACKEND=memory          # L1-only (tek pod / yerel)
# CACHE_BACKEND=redis           # L1 + Redis L2 + Pub/Sub invalidation (çok pod)
# REDIS_URL=redis://127.0.0.1:6379
# CACHE_REQUIRED=false          # Redis yoksa veya kesilirse L1-only devam (varsayılan)

# GTM_CONTAINER_ID=GTM-ABC123
# CACHE_PURGE_SECRET=your-local-secret
# REFERRAL_STATS_SECRET=your-local-referral-stats-secret
# MARKET_STREAM_TOKEN=your-local-market-stream-secret
# AUTH_REFRESH_COORDINATION_SECRET=your-local-auth-coordination-secret
# AUTH_REFRESH_COORDINATION_PREVIOUS_SECRET=
