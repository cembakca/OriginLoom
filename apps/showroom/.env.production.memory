# Referans overlay — npm run start:memory
# Script, .env.production yüklendikten sonra cache değerlerini memory'ye çevirir.
# Redis gerekmez; process restart sonrası cache sıfırlanır.
#
# Yerel gateway/URL için .env.production.local kullanın.

# Never changes, unlike RELEASE_ID: it namespaces coordination state, which has
# to survive a rolling deploy and must not be shared with another product on the
# same Redis. Required in production. See docs/namespaces.md.
APP_ID=showroom
