{
  "name": "@originloom/react",
  "version": "0.7.41",
  "description": "React renderer adapter for OriginLoom: island runtime, document rendering and the Vite preset.",
  "license": "UNLICENSED",
  "author": "Cem Bakca",
  "homepage": "https://github.com/cembakca/OriginLoom/tree/main/packages/origin-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cembakca/OriginLoom.git",
    "directory": "packages/origin-react"
  },
  "keywords": [
    "originloom",
    "react",
    "ssr",
    "islands"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.18.1"
  },
  "exports": {
    "./lib/island": "./src/lib/island.tsx",
    "./lib/link": "./src/lib/link.tsx",
    "./lib/request-context": "./src/lib/request-context.tsx",
    "./lib/query/provider": "./src/lib/query/provider.tsx",
    "./lib/client/island-mount": "./src/lib/client/island-mount.tsx",
    "./lib/metadata/metadata-head": "./src/lib/metadata/metadata-head.tsx",
    "./lib/server-island": "./src/lib/server-island.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./server": "./src/server/index.ts",
    "./vite": "./src/vite/preset.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@originloom/shared": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.1.5"
  },
  "publishConfig": {
    "registry": "http://localhost:4873",
    "exports": {
      "./lib/island": {
        "types": "./dist/lib/island.d.ts",
        "default": "./dist/lib/island.js"
      },
      "./lib/link": {
        "types": "./dist/lib/link.d.ts",
        "default": "./dist/lib/link.js"
      },
      "./lib/request-context": {
        "types": "./dist/lib/request-context.d.ts",
        "default": "./dist/lib/request-context.js"
      },
      "./lib/query/provider": {
        "types": "./dist/lib/query/provider.d.ts",
        "default": "./dist/lib/query/provider.js"
      },
      "./lib/client/island-mount": {
        "types": "./dist/lib/client/island-mount.d.ts",
        "default": "./dist/lib/client/island-mount.js"
      },
      "./lib/metadata/metadata-head": {
        "types": "./dist/lib/metadata/metadata-head.d.ts",
        "default": "./dist/lib/metadata/metadata-head.js"
      },
      "./lib/server-island": {
        "types": "./dist/lib/server-island.d.ts",
        "default": "./dist/lib/server-island.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./vite": {
        "types": "./dist/vite/preset.d.ts",
        "default": "./dist/vite/preset.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
