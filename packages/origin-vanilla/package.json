{
  "name": "@originloom/vanilla",
  "version": "0.3.5",
  "description": "Framework-free renderer adapter for OriginLoom: an html tagged template, island markers and a plain-module island mounter.",
  "license": "UNLICENSED",
  "author": "Cem Bakca",
  "homepage": "https://github.com/cembakca/OriginLoom/tree/main/packages/origin-vanilla#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cembakca/OriginLoom.git",
    "directory": "packages/origin-vanilla"
  },
  "keywords": [
    "originloom",
    "ssr",
    "html",
    "islands",
    "no-framework"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./server": "./src/server/index.ts",
    "./client/*": "./src/client/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./vite": "./src/vite/preset.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@originloom/shared": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "vite": "^8.1.5"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "http://localhost:4873",
    "exports": {
      "./server": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "./client/*": {
        "types": "./dist/client/*.d.ts",
        "default": "./dist/client/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./vite": {
        "types": "./dist/vite/preset.d.ts",
        "default": "./dist/vite/preset.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
