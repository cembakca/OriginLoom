{
  "name": "@originloom/shared",
  "version": "0.7.33",
  "description": "Framework-neutral base for OriginLoom: route and request types, the routing engine, the metadata engine and the OriginRenderer contract.",
  "license": "UNLICENSED",
  "author": "Cem Bakca",
  "homepage": "https://github.com/cembakca/OriginLoom/tree/main/packages/origin-shared#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cembakca/OriginLoom.git",
    "directory": "packages/origin-shared"
  },
  "keywords": [
    "originloom",
    "ssr",
    "routing",
    "metadata",
    "types"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.18.1"
  },
  "exports": {
    "./lib/*": "./src/lib/*.ts",
    "./routing": "./src/routing/index.ts",
    "./routing/*": "./src/routing/*.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "publishConfig": {
    "registry": "http://localhost:4873",
    "exports": {
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./routing": {
        "types": "./dist/routing/index.d.ts",
        "default": "./dist/routing/index.js"
      },
      "./routing/*": {
        "types": "./dist/routing/*.d.ts",
        "default": "./dist/routing/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vite": "^8.1.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
