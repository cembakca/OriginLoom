{
  "name": "@originloom/core",
  "version": "0.3.8",
  "description": "OriginLoom server runtime: SSR pipeline, layered HTML cache, middleware, security, metrics — with no UI framework of its own.",
  "license": "UNLICENSED",
  "author": "Cem Bakca",
  "homepage": "https://github.com/cembakca/OriginLoom/tree/main/packages/origin-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cembakca/OriginLoom.git",
    "directory": "packages/origin-core"
  },
  "keywords": [
    "originloom",
    "ssr",
    "hono",
    "cache",
    "server"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    "./app/*": null,
    "./cache/cold-fill": null,
    "./cache/revalidation": null,
    "./document/*": null,
    "./metrics/cache-label": null,
    "./metrics/runtime": null,
    "./middleware/context": null,
    "./middleware/pipeline": null,
    "./middleware/static-assets": null,
    "./middleware/steps/auth/refresh-result": null,
    "./middleware/steps/redirection/gone": null,
    "./public-url": null,
    "./ssr/*": null,
    "./cache": "./src/cache/index.ts",
    "./middleware/steps/auth": "./src/middleware/steps/auth/index.ts",
    "./middleware/steps/redirection": "./src/middleware/steps/redirection/index.ts",
    "./middleware/steps/session": "./src/middleware/steps/session/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@originloom/shared": "workspace:*",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "http://localhost:4873",
    "exports": {
      "./app/*": null,
      "./cache/cold-fill": null,
      "./cache/revalidation": null,
      "./document/*": null,
      "./metrics/cache-label": null,
      "./metrics/runtime": null,
      "./middleware/context": null,
      "./middleware/pipeline": null,
      "./middleware/static-assets": null,
      "./middleware/steps/auth/refresh-result": null,
      "./middleware/steps/redirection/gone": null,
      "./public-url": null,
      "./ssr/*": null,
      "./cache": {
        "types": "./dist/cache/index.d.ts",
        "default": "./dist/cache/index.js"
      },
      "./middleware/steps/auth": {
        "types": "./dist/middleware/steps/auth/index.d.ts",
        "default": "./dist/middleware/steps/auth/index.js"
      },
      "./middleware/steps/redirection": {
        "types": "./dist/middleware/steps/redirection/index.d.ts",
        "default": "./dist/middleware/steps/redirection/index.js"
      },
      "./middleware/steps/session": {
        "types": "./dist/middleware/steps/session/index.d.ts",
        "default": "./dist/middleware/steps/session/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist"
  ]
}
