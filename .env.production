# Production şablonu — gerçek secret'ları .env.production.local ile override edin
# veya platform secret manager (k8s Secret, Vercel env vb.) kullanın.
NODE_ENV=production
APP_ENV=production
PORT=3005
METRICS_PORT=9090
CLIENT_ERROR_RATE_LIMIT=120
CLIENT_ERROR_WINDOW_MS=60000
CLIENT_ERROR_SAMPLE_RATE=1
CLIENT_ERROR_IP_RATE_LIMIT=20
CLIENT_ERROR_IP_MAX_ENTRIES=10000
CLIENT_ERROR_IP_TTL_MS=300000
SSR_REQUEST_TIMEOUT_MS=15000
API_REQUEST_TIMEOUT_MS=12000
PROXY_REQUEST_TIMEOUT_MS=8000
SSR_MAX_CONCURRENCY=32
SSR_MAX_QUEUE=64
SSR_QUEUE_WAIT_MS=250
CACHE_BACKEND=redis
CACHE_REQUIRED=false
REDIS_URL=redis://managed-redis.example.internal:6379
CACHE_FILL_TIMEOUT_MS=12000
CACHE_FILL_WAIT_MS=12500
CACHE_FILL_POLL_MS=100
BOT_ANALYTICS_QUEUE_CAPACITY=1000
BOT_ANALYTICS_CONCURRENCY=2
BOT_ANALYTICS_BATCH_SIZE=25
BOT_ANALYTICS_FLUSH_MS=250
BOT_ANALYTICS_DEDUP_TTL_MS=60000
BOT_ANALYTICS_SAMPLE_RATE=1
BOT_ANALYTICS_DRAIN_TIMEOUT_MS=3000
GATEWAY_URL=https://gateway.example.com
SITE_URL=https://www.example.com
# Search Console / Webmaster doğrulama token'ları (opsiyonel)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
RELEASE_ID=replace-with-release-or-git-sha
CACHE_PURGE_SECRET=replace-with-a-long-random-secret
REFERRAL_STATS_SECRET=replace-with-a-different-long-random-secret
MARKET_STREAM_TOKEN=replace-with-an-internal-market-stream-secret
TRUST_PROXY=true
OTEL_SDK_DISABLED=false
